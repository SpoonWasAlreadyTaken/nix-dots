configuration {
    display-drun: "Application";
    display-window: "Windows";
    drun-display-format: "{icon} {name}";
    font: "CaskaydiaCove Nerd Font Bold 14";
    modi: "window,run,drun";
    show-icons: true;
    icon-theme: "Papirus";
}

@theme "/dev/null"
@import "~/.config/theme/colors.rasi"


* {
    background-color: @colorBG;
    text-color: @colorFG;

    border: 0;
    margin: 0;
    padading: 0;
    spacing: 0;
}

window {
    width: 45%;
    border: 1px;
    border-radius: 8px;
    border-color: @colorFGLighter;
}

textbox {
    padding: 8;
}

element {
    text-color: @colorFG;

    padding: 12;
    spacing: 8;

    border: 0px 0px 1px 0px;
    border-color: @colorDarker;
}

element selected {
    background-color: @colorDark;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 30;
    background-color: inherit;
    text-color: inherit;
}

element selected normal, element selected active {
    text-color: @colorFGLight;
}


inputbar {
    children: [prompt, entry];
    border: 0px 0px 2px 0;
    border-color: @colorDarker;
}

entry {
    background-color: @colorBG;
    padding: 12;
    text-color: #ffffff;
}

prompt {
    vertical-align: 0.5;
    text-color: @colorDim;
    padding: 0px 0px 0px 12px;
}

listview {
    background-color: @colorBG;
    columns: 1;
    lines: 7;
}

























